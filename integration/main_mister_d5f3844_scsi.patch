+static void lsi_scsi_uninit(PCIDevice *d)
+{
+    LSIState710 *s = LSI53C895A(d);
+
+    memory_region_destroy(&s->mmio_io);
+    memory_region_destroy(&s->ram_io);
+    memory_region_destroy(&s->io_io);
+}
