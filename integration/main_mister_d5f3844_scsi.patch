+}
+
+// ---- A4091 shadow-register RAM <-> LSIState710 -------------------------
+// The FPGA bridge's 256-byte shadow RAM is the CPU-visible register file.
+// On a kick the ARM loads it into the model, runs SCRIPTS, stores it back.
+// Direct field copy (no lsi_reg_* side effects).
+static uint32_t rd32(const uint8_t *r) { return r[0] | (r[1]<<8) | (r[2]<<16) | ((uint32_t)r[3]<<24); }
+static uint32_t rd24(const uint8_t *r) { return r[0] | (r[1]<<8) | (r[2]<<16); }
+static void     wr32(uint8_t *r, uint32_t v) { r[0]=v; r[1]=v>>8; r[2]=v>>16; r[3]=v>>24; }
+static void     wr24(uint8_t *r, uint32_t v) { r[0]=v; r[1]=v>>8; r[2]=v>>16; }
+
+extern "C" void a4091_lsi_load(DeviceState *dev, const uint8_t r[256])
+{
+	LSIState710 *s = LSI53C895A(dev);
+	s->scntl0 = r[0x00]; s->scntl1 = r[0x01]; s->sdid = r[0x02]; s->sien0 = r[0x03];
+	s->scid   = r[0x04]; s->sxfer  = r[0x05]; s->sodl = r[0x06]; s->socl  = r[0x07];
+	s->sfbr   = r[0x08]; s->sidl   = r[0x09]; s->sbcl = r[0x0b];
+	s->dstat  = r[0x0c]; s->sstat0 = r[0x0d]; s->sstat1 = r[0x0e]; s->sstat2 = r[0x0f];
+	s->dsa    = rd32(r + 0x10);
+	s->temp   = rd32(r + 0x1c);
+	s->istat  = r[0x21];
+	s->dbc    = rd24(r + 0x24);
+	s->dcmd   = r[0x27];
+	s->dnad   = rd32(r + 0x28);
+	s->dsp    = rd32(r + 0x2c);
+	s->dsps   = rd32(r + 0x30);
+	s->scratch= rd32(r + 0x34);
+	s->dmode  = r[0x38]; s->dien = r[0x39]; s->dwt = r[0x3a]; s->dcntl = r[0x3b];
+}
+
+extern "C" void a4091_lsi_store(DeviceState *dev, uint8_t r[256])
+{
+	LSIState710 *s = LSI53C895A(dev);
+	r[0x00] = s->scntl0; r[0x01] = s->scntl1; r[0x02] = s->sdid; r[0x03] = s->sien0;
+	r[0x04] = s->scid;   r[0x05] = s->sxfer;  r[0x06] = s->sodl; r[0x07] = s->socl;
+	r[0x08] = s->sfbr;   r[0x09] = s->sidl;   r[0x0a] = 0;       r[0x0b] = s->sbcl;
+	r[0x0c] = s->dstat;  r[0x0d] = s->sstat0; r[0x0e] = s->sstat1; r[0x0f] = s->sstat2;
+	wr32(r + 0x10, s->dsa);
+	wr32(r + 0x1c, s->temp);
+	r[0x21] = s->istat;
+	wr24(r + 0x24, s->dbc);
+	r[0x27] = s->dcmd;
+	wr32(r + 0x28, s->dnad);
+	wr32(r + 0x2c, s->dsp);
+	wr32(r + 0x30, s->dsps);
+	wr32(r + 0x34, s->scratch);
+	r[0x38] = s->dmode; r[0x39] = s->dien; r[0x3a] = s->dwt; r[0x3b] = s->dcntl;
+
+	// CTEST1 (struct offset 0x16 in the driver's byte-swapped siopreg.h view):
+	// bits 7:4 = "DMA FIFO bottom byte empty". We have no FIFO - every DMA is
+	// an instant memcpy - so report it permanently empty. Without this the
+	// driver's siop_checkintr() spins `while ((ctest1 & 0xf0) != 0xf0)` to its
+	// 10000-iteration timeout on EVERY interrupt (~3.5 ms of Zorro reads per
+	// SCSI command - the throughput killer). Also CTEST8 auto-clears CLF.
+	r[0x16] = 0xf0;
+}
+
+// Run SCRIPTS from the loaded DSP. Returns nonzero if an interrupt is
+// pending (ISTAT.SIP | ISTAT.DIP) i.e. the ARM should raise a4091_int2.
+extern "C" int a4091_lsi_run(DeviceState *dev)
+{
+	LSIState710 *s = LSI53C895A(dev);
+	s->bus.qbus.parent = dev;
+	s->waiting = 0;
+	lsi_execute_script(s);
+	return (s->istat & (LSI_ISTAT_SIP | LSI_ISTAT_DIP)) ? 1 : 0;
+}
+
+extern "C" int a4091_lsi_irq_pending(DeviceState *dev)
+{
+	LSIState710 *s = LSI53C895A(dev);
+	return (s->istat & (LSI_ISTAT_SIP | LSI_ISTAT_DIP)) ? 1 : 0;
+}
+
