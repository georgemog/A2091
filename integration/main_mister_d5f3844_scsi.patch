+
+// Per-SCRIPTS-instruction tracing. OFF by default: it logs ~15 lines per
+// SCSI command and fflush()es to USB, which throttles I/O ~10x and dumps
+// 100 MB+ during a full format. Re-enable with `-DA4091_SWSIOP_TRACE`.
+#if defined(A4091_SWSIOP_TRACE) || defined(DEBUG_LSI)
+#define DPRINTF(fmt, ...) \
+do { write_log("lsi_scsi: " fmt , ## __VA_ARGS__); } while (0)
+#else
+#define DPRINTF(fmt, ...) do {} while(0)
+#endif
+// BADF always logs (an odd message/phase from a real driver must never
+// kill the core) - no assert, no matter the build.
+#define BADF(fmt, ...) \
+do { write_log("lsi_scsi: error: " fmt , ## __VA_ARGS__); } while (0)
+
+#define LSI_MAX_DEVS 7
+
