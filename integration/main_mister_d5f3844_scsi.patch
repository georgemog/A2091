+	case 0x21: /* ISTAT */
+        s->istat = (s->istat & 0x0f) | (val & 0xf0);
+        if (val & LSI_ISTAT_ABRT) {
+            lsi_script_dma_interrupt(s, LSI_DSTAT_ABRT);
