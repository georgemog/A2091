diff --git a/menu.cpp b/menu.cpp
index c084ac8..4cbeb11 100644
--- a/menu.cpp
+++ b/menu.cpp
@@ -65,6 +65,8 @@ along with this program.  If not, see <http://www.gnu.org/licenses/>.
 #include "support.h"
 #include "bootcore.h"
 #include "ide.h"
+#include "support/minimig/minimig_a4091.h"
+#include "support/minimig/minimig_a2091.h"
 #include "profiling.h"
 #include "str_util.h"
 #include "autofire.h"
@@ -182,6 +184,7 @@ enum MENU
 	MENU_MINIMIG_DISK1,
 	MENU_MINIMIG_DISK2,
 	MENU_MINIMIG_HDFFILE_SELECTED,
+	MENU_MINIMIG_SCSIFILE_SELECTED,
 	MENU_MINIMIG_CD32FILE_SELECTED,
 	MENU_MINIMIG_CDTVFILE_SELECTED,
 	MENU_MINIMIG_CD32FILE_START,
@@ -356,6 +359,7 @@ static char SelectedLabel[1024] = {};
 
 static char Selected_F[16][1024] = {};
 static char Selected_S[16][1024] = {};
+static char Selected_A4091[6][1024] = {};
 static char Selected_tmp[1024] = {};
 static char Selected_CD32[1024] = {};
 static char Selected_CDTV[1024] = {};
@@ -6853,7 +6857,7 @@ void HandleUI(void)
 			m = 0;
 			if (!menusub) firstmenu = 0;
 			adjvisible = 0;
-			menumask = 0x4010;
+			menumask = 0x10;
 
 			MenuWrite(m++, "", 0, 0);
 
@@ -6954,8 +6958,50 @@ void HandleUI(void)
 				}
 			}
 
+			// SCSI controller: A2091 (Zorro II, any CPU) or A4091 (Zorro III,
+			// 68020+ only). Inlined here (IDs 1..6 scroll with the IDE drives,
+			// no sub-page). menusub 14, then 15/16..25/26 for the six ID
+			// type/path pairs. Takes effect on the next reset.
+			int scsi_ctrl = minimig_scsi_controller();
+			if (a2091_core_supported() || (minimig_config.cpu & 2))
+			{
+				MenuWrite(m++);   // gap between the IDE drives and SCSI
+				int scsi_on = scsi_ctrl != SCSI_CTRL_NONE;
+				strcpy(s, " SCSI controller  : ");
+				strcat(s, scsi_ctrl == SCSI_CTRL_A2091 ? "A2091" : scsi_ctrl == SCSI_CTRL_A4091 ? "A4091" : "Disabled");
+				MenuWrite(m++, s, menusub == 14, 0);
+				menumask |= ((uint64_t)1 << 14);
+
+				if (scsi_on)
+				{
+					for (uint i = 0; i < 6; i++)
+					{
+						uint tsub = 15 + i * 2;
+						snprintf(s, sizeof(s), " \x1bID%u            : ", i + 1);
+						strcat(s, minimig_config.scsi[i].cfg ? "Fixed/HDD" : "Disabled");
+						MenuWrite(m++, s, menusub == tsub, 0);
+						menumask |= ((uint64_t)1 << tsub);
+
+						if (minimig_config.scsi[i].filename[0])
+						{
+							strcpy(s, "                                ");
+							char *path = HomeDir();
+							int len = strlen(path);
+							char *name = minimig_config.scsi[i].filename;
+							if (!strncasecmp(name, path, len)) name += len + 1;
+							strncpy(&s[3], name, 25);
+						}
+						else strcpy(s, "   ** not selected **");
+						enable = minimig_config.scsi[i].cfg ? 1 : 0;
+						if (enable) menumask |= ((uint64_t)1 << (tsub + 1));
+						MenuWrite(m++, s, menusub == (tsub + 1), enable == 0);
+					}
+				}
+			}
+
 			while (m - firstmenu < OsdGetSize() - 1) MenuWrite(m++);
-			MenuWrite(m++, STD_BACK, menusub == 14, 0);
+			MenuWrite(m++, STD_BACK, menusub == 27, 0);
+			menumask |= ((uint64_t)1 << 27);
 
 			menustate = MENU_MINIMIG_DISK2;
 
@@ -7070,7 +7116,57 @@ void HandleUI(void)
 					else if (recent_init(500)) menustate = MENU_RECENT1;
 				}
 			}
-			else if (menusub == 14 && select) // return to previous menu
+			else if (menusub == 14) // SCSI controller: Disabled -> A2091 -> A4091 (68020+)
+			{
+				if (select || minus || plus)
+				{
+					// build the list of what this core / CPU can offer
+					int opts[3], n = 0, cur = 0;
+					opts[n++] = SCSI_CTRL_NONE;
+					if (a2091_core_supported()) opts[n++] = SCSI_CTRL_A2091;
+					if ((minimig_config.cpu & 2) && a4091_core_supported()) opts[n++] = SCSI_CTRL_A4091;
+					int ctrl = minimig_scsi_controller();
+					for (int k = 0; k < n; k++) if (opts[k] == ctrl) cur = k;
+					cur = minus ? (cur + n - 1) % n : (cur + 1) % n;
+					switch (opts[cur])
+					{
+					case SCSI_CTRL_NONE:  minimig_config.scsi_cfg &= ~1; break;
+					case SCSI_CTRL_A2091: minimig_config.scsi_cfg |= 3; break;
+					case SCSI_CTRL_A4091: minimig_config.scsi_cfg = (minimig_config.scsi_cfg | 1) & ~2; break;
+					}
+					a4091_apply_config();
+					a2091_apply_config();
+					menustate = MENU_MINIMIG_DISK1;
+				}
+			}
+			else if (menusub >= 15 && menusub <= 26) // A4091 ID1..ID6 (type/path)
+			{
+				int idx = (menusub - 15) / 2;
+				if (menusub & 1) // odd = type line
+				{
+					if (select || minus || plus)
+					{
+						minimig_config.scsi[idx].cfg = minimig_config.scsi[idx].cfg ? 0 : 1;
+						a4091_apply_config();
+					a2091_apply_config();
+						menustate = MENU_MINIMIG_DISK1;
+					}
+				}
+				else if (select || recent) // even = path line
+				{
+					fs_Options = SCANO_DIR | SCANO_UMOUNT;
+					fs_MenuSelect = MENU_MINIMIG_SCSIFILE_SELECTED;
+					fs_MenuCancel = MENU_MINIMIG_DISK1;
+					strcpy(fs_pFileExt, "HDFVHDIMGDSK");
+					if (select)
+					{
+						if (!Selected_A4091[idx][0]) memcpy(Selected_A4091[idx], minimig_config.scsi[idx].filename, sizeof(Selected_A4091[idx]));
+						SelectFile(Selected_A4091[idx], fs_pFileExt, fs_Options, fs_MenuSelect, fs_MenuCancel, 503);
+					}
+					else if (recent_init(503)) menustate = MENU_RECENT1;
+				}
+			}
+			else if (menusub == 27 && select) // return to previous menu
 			{
 				firstmenu = 0;
 				menustate = MENU_MINIMIG_MAIN1;
@@ -7090,6 +7186,24 @@ void HandleUI(void)
 		}
 		break;
 
+	case MENU_MINIMIG_SCSIFILE_SELECTED:
+		{
+			int idx = (menusub - 15) / 2;
+			if (idx < 0) idx = 0;
+			if (idx > 5) idx = 5;
+			memcpy(Selected_A4091[idx], selPath, sizeof(Selected_A4091[idx]));
+			recent_update(SelectedDir, selPath, SelectedLabel, 503);
+			uint len = strlen(selPath);
+			if (len > sizeof(minimig_config.scsi[idx].filename) - 1) len = sizeof(minimig_config.scsi[idx].filename) - 1;
+			if (len) memcpy(minimig_config.scsi[idx].filename, selPath, len);
+			minimig_config.scsi[idx].filename[len] = 0;
+			if (!minimig_config.scsi[idx].cfg) minimig_config.scsi[idx].cfg = 1;
+			a4091_apply_config();
+					a2091_apply_config();
+			menustate = MENU_MINIMIG_DISK1;
+		}
+		break;
+
 	case MENU_MINIMIG_HDFFILE_SELECTED:
 		{
 			memcpy(Selected_S[(menusub - 7) / 2], selPath, sizeof(Selected_S[(menusub - 2) / 2]));
