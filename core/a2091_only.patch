+		a2091_dma_req_q <= 1'b0;
 	end else begin
 		akiko_dma_req_q <= akiko_dma_req;
 		cdtv_dma_req_q  <= cdtv_dma_req;
+		a2091_dma_req_q <= a2091_dma_req & ~a2091_ack_r;
 	end
 end
 
@@ -111,33 +123,44 @@ reg [1:0] state;
 reg [7:0] ak_rbyte_r;
 reg       ak_ack_r;
 reg       cdtv_ack_r;
+reg [15:0] a2091_rdata_r;
 
 reg active_is_cdtv;
+reg active_is_a2091;
 
 assign akiko_dma_rbyte = ak_rbyte_r;
 assign akiko_dma_ack   = ak_ack_r;
 assign cdtv_dma_rbyte  = 8'h00;
 assign cdtv_dma_ack    = cdtv_ack_r;
+assign a2091_dma_rdata = a2091_rdata_r;
+assign a2091_dma_ack   = a2091_ack_r;
 
 wire minimig_idle = chip_in_dma & chip_in_rw;
 
