@@ -58,13 +66,17 @@ wire c_7m_rise = c_7m & ~c_7m_d;
 
 reg akiko_dma_req_q;
 reg cdtv_dma_req_q;
+reg a2091_ack_r;
+reg a2091_dma_req_q;
 always @(posedge clk) begin
 	if (reset) begin
 		akiko_dma_req_q <= 1'b0;
